# Load order matters: Core sets up the namespace and saved
# variables, Constants holds pure data, the feature modules depend
# on both, and UI depends on every feature module existing first.
# Waypoint.lua and LureOverlay.lua are independent of each other -
# neither calls into the other - so their relative order here
# doesn't matter.
Core.lua
Constants.lua
Names.lua
Quests.lua
Crafting.lua
Waypoint.lua
LureOverlay.lua
AuctionHouse.lua
Options.lua
UI.lua
